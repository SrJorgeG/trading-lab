
!.env.example
# Datos e informes pesados (se regeneran)
# Estado local del ejecutor
# Python / uv
# Secretos
*.key
*.parquet
*.pyc
.env
.env.*
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
KILL_SWITCH
__pycache__/
data/cache/
data_cache/
logs/
reports/**/*.html
reports/**/*.parquet
state/

# Informes Monte Carlo interactivos (se versionan a propósito)
!reports/**/montecarlo_*.html
# Informes de robustez interactivos (mapa de parámetros y contra el azar)
!reports/robustez/**/*.html
